    "expected": "{\nx\"name\": \"invoke_skill\",\nx\"parameters\": {\nxx\"type\": \"object\",\nxx\"properties\": {\nxxx\"text\": {\nxxxx\"type\": [\nxxxxx\"string\",\nxxxxx\"null\"\nxxxx],\nxxxx\"minLength\": 1,\nxxxx\"maxLength\": 80,\nxxxx\"const\": \"a/b\"\nxxx}\nxx},\nxx\"additionalProperties\": false,\nxx\"anyOf\": [\nxxx{\nxxxx\"required\": [\nxxxxx\"text\"\nxxxx]\nxxx},\nxxx{\nxxxx\"type\": \"null\"\nxxx}\nxx]\nx}\n}"
  },
  {
    "id": "schema-compact",
