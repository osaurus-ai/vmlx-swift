    "expected": "{\"name\" = \"invoke_skill\" | \"parameters\" = {\"type\" = \"object\" | \"properties\" = {\"text\" = {\"type\" = [\"string\" | \"null\"] | \"minLength\" = 1 | \"maxLength\" = 80 | \"const\" = \"a/b\"}} | \"additionalProperties\" = false | \"anyOf\" = [{\"required\" = [\"text\"]} | {\"type\" = \"null\"}]}}"
