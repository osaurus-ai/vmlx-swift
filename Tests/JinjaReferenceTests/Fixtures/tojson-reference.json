    "expected": "{\"name\":\"invoke_skill\",\"parameters\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":[\"string\",\"null\"],\"minLength\":1,\"maxLength\":80,\"const\":\"a/b\"}},\"additionalProperties\":false,\"anyOf\":[{\"required\":[\"text\"]},{\"type\":\"null\"}]}}"
  },
  {
    "id": "schema-sorted",
    "template": "{{ {'name':'invoke_skill','parameters':{'type':'object','properties':{'text':{'type':['string','null'],'minLength':1,'maxLength':80,'const':'a/b'}},'additionalProperties':false,'anyOf':[{'required':['text']},{'type':'null'}]}} | tojson(sort_keys=true) }}",
    "expected": "{\"name\": \"invoke_skill\", \"parameters\": {\"additionalProperties\": false, \"anyOf\": [{\"required\": [\"text\"]}, {\"type\": \"null\"}], \"properties\": {\"text\": {\"const\": \"a/b\", \"maxLength\": 80, \"minLength\": 1, \"type\": [\"string\", \"null\"]}}, \"type\": \"object\"}}"
  },
  {
    "id": "schema-sortedpretty",
    "template": "{{ {'name':'invoke_skill','parameters':{'type':'object','properties':{'text':{'type':['string','null'],'minLength':1,'maxLength':80,'const':'a/b'}},'additionalProperties':false,'anyOf':[{'required':['text']},{'type':'null'}]}} | tojson(sort_keys=true,indent=2,ensure_ascii=true) }}",
    "expected": "{\n  \"name\": \"invoke_skill\",\n  \"parameters\": {\n    \"additionalProperties\": false,\n    \"anyOf\": [\n      {\n        \"required\": [\n          \"text\"\n        ]\n      },\n      {\n        \"type\": \"null\"\n      }\n    ],\n    \"properties\": {\n      \"text\": {\n        \"const\": \"a/b\",\n        \"maxLength\": 80,\n        \"minLength\": 1,\n        \"type\": [\n          \"string\",\n          \"null\"\n        ]\n      }\n    },\n    \"type\": \"object\"\n  }\n}"
  },
  {
    "id": "schema-custom",
