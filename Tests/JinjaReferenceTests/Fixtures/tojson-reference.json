    "expected": "{\n\"name\": \"invoke_skill\",\n\"parameters\": {\n\"type\": \"object\",\n\"properties\": {\n\"text\": {\n\"type\": [\n\"string\",\n\"null\"\n],\n\"minLength\": 1,\n\"maxLength\": 80,\n\"const\": \"a/b\"\n}\n},\n\"additionalProperties\": false,\n\"anyOf\": [\n{\n\"required\": [\n\"text\"\n]\n},\n{\n\"type\": \"null\"\n}\n]\n}\n}"
  },
